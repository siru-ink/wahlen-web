{{ define "_css.tmpl" }}
<style>
:root {
    --background-color: #FFEBD6;
    --text-background: white;
    --text-color: black;
    --text-color-offset: grey;
    --text-accent-color: #EF7B00;
}

*, *::before, *::after {
    box-sizing: border-box;
}

a {
    color: var(--text-accent-color);
}

body {
    background-color: var(--background-color);
}

#pageContent {
    max-width: 720px;
    margin: 0 auto;
    font-family: "Calibri", "Carlito", sans-serif;
    background-color: var(--text-background);
}

form {
    padding: 0.5em 1em;
    margin: 1em 0;

    input:not([type="checkbox"]) {
        display: block;
        max-width: 300px;
        font-family: inherit;
        font-size: 1em;
        border-radius: 0;
        border: 1px solid var(--text-color);
        padding: 0.3em 0.7em;

        &:focus-visible {
            outline: 2px solid var(--text-accent-color);
            box-shadow: none;
        }
    }

    button {
        display: block;
        max-width: max-content;
        font-family: inherit;
        font-size: 1em;
        border: none;
        box-shadow: 2px 2px black;
        background-color: var(--text-accent-color);
        color: white;

        &:active {
            position: relative;
            top: 2px;
            left: 2px;
            box-shadow: none;
        }
    }
}
</style>
{{ end }}
