[
  {
    "label": "Goose Make Migrations Sequential",
    "command": "goose",
    "args": ["fix"],
    "env": {
      "GOOSE_DRIVER": "sqlite3",
      "GOOSE_DBSTRING": "data.db",
      "GOOSE_MIGRATION_DIR": "./internal/db/migrations/"
    },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "all",
  },
  {
    "label": "Goose Make New Migration",
    "command": "goose",
    "args": ["create", "new", "sql"],
    "env": {
      "GOOSE_DRIVER": "sqlite3",
      "GOOSE_DBSTRING": "data.db",
      "GOOSE_MIGRATION_DIR": "./internal/db/migrations/"
    },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "all",
  },
  {
    "label": "Build Server Application",
    "command": "go",
    "args": ["build", "./cmd/server/"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "all",
  },
]
